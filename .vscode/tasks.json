{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Firmware Pair (flashable)",
            "type": "process",
            "command": "sh",
            "args": [
                "${workspaceFolder}/tools/build-firmware-pair.sh"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build Firmware Pair (no live owner)",
            "type": "process",
            "command": "sh",
            "args": [
                "${workspaceFolder}/tools/build-firmware-pair.sh",
                "--no-owner"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build QMK",
            "type": "shell",
            "command": "zsh -i -c 'qmk-build'",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build QMK with Compilation Database",
            "type": "shell",
            "command": "qmk compile --compiledb -kb bastardkb/charybdis/4x6 -km noah",
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Run VIA to QMK Layout Sync",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/via_to_qmk_layout.py"
            ],
            "problemMatcher": []
        },
        {
            "label": "Generate Layout Overview",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/profile_introspect.py"
            ],
            "problemMatcher": []
        },
        {
            "label": "Install Profile Studio Extension",
            "type": "process",
            "command": "${workspaceFolder}/tools/charybdis-profile-studio/scripts/install-local.sh",
            "problemMatcher": []
        },
        {
            "label": "Install Charybdis Live Extension",
            "type": "process",
            "command": "${workspaceFolder}/tools/charybdis-live/scripts/install-local.sh",
            "problemMatcher": []
        },
        {
            "label": "Regenerate Live Keycode Catalog",
            "type": "process",
            "command": "npm",
            "args": [
                "--prefix",
                "${workspaceFolder}/tools/charybdis-live",
                "run",
                "keycodes"
            ],
            "problemMatcher": []
        },
        {
            "label": "Format repo",
            "type": "process",
            "command": "bash",
            "args": [
                "-c",
                "git ls-files '*.c' '*.cc' '*.cpp' '*.h' '*.hpp' | xargs clang-format -i"
            ],
            "problemMatcher": []
        }
    ]
}
