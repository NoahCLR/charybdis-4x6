{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Firmware Pair (flashable)",
            "type": "process",
            "command": "sh",
            "args": [
                "${workspaceFolder}/tools/build-firmware-pair.sh"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "NOAH_ALLOW_UNPINNED_QMK": "1"
                }
            }
        },
        {
            "label": "Build Firmware Pair (no live owner)",
            "type": "process",
            "command": "sh",
            "args": [
                "${workspaceFolder}/tools/build-firmware-pair.sh",
                "--no-owner"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "NOAH_ALLOW_UNPINNED_QMK": "1"
                }
            }
        },
        {
            "label": "Build right half + compilation database",
            "type": "process",
            "command": "qmk",
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "options": {
                "cwd": "${workspaceFolder}/../bastardkb-qmk",
                "env": {
                    "QMK_USERSPACE": "${workspaceFolder}"
                }
            },
            "args": [
                "compile",
                "--compiledb",
                "-kb",
                "bastardkb/charybdis/4x6",
                "-km",
                "noah",
                "-e",
                "FORCE_MASTER=yes",
                "-e",
                "NOAH_PHYSICAL_HALF=right"
            ]
        },
        {
            "label": "Generate Layout Overview",
            "type": "process",
            "command": "python3",
            "args": [
                "${workspaceFolder}/tools/profile_introspect.py"
            ],
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Format repo",
            "type": "process",
            "command": "bash",
            "args": [
                "-c",
                "git ls-files '*.c' '*.cc' '*.cpp' '*.h' '*.hpp' | xargs clang-format -i"
            ],
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Run all firmware host tests",
            "type": "process",
            "command": "sh",
            "args": [
                "${workspaceFolder}/tests/host/run_all_host_tests.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
